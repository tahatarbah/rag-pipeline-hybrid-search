# Chat model via Ollama (optional — retrieval works without it)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Dense vectors: "hash" uses local hashed bag-of-words (no extra models)
# Set to an Ollama embedding model name (e.g. nomic-embed-text) for neural embeddings
EMBEDDING_MODEL=hash

PUBLIC_ORIGIN=http://127.0.0.1:8765
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Optional SSO (leave blank to disable)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional cross-encoder rerank (needs sentence-transformers; leave false)
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base

# Retrieval
TOP_K=6
RETRIEVE_K=20
RRF_K=60
MAX_CHUNKS_PER_SOURCE=2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
